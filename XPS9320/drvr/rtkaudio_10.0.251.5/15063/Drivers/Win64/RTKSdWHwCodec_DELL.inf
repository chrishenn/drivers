[RTKSdWHwCodecSYS.CopyList]
RTKSdWHwCodec.sys
RTAIODAT.DAT

[RTKSdWHwCodecDAT.CopyList]
RTKSdWHwCodec.DAT


[RTKSdWHwCodec_Device.NTamd64]
CopyFiles=RTKSdWHwCodecSYS.CopyList,RTKSdWHwCodecDAT.CopyList
AddReg = RTKSdWHwCodecModelAddReg

[RTKSdWHwCodec_Device.NTamd64.HW]
AddReg = RTKSdWHwCodecModelAddReg_HW

[RTKSdWHwCodecModelAddReg]
HKR,,Driver,,RTKSdWHwCodec.sys
HKR,Settings,DriverStorePath,,%13%

[RTKSdWHwCodecModelAddReg_HW]
HKR,"WDF","WdfDirectedPowerTransitionEnable",0x00010001,1
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)" ; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX


;-------------- Service installation
[RTKSdWHwCodec_Device.NTamd64.Services]
AddService = RTKSdWHwCodec,%SPSVCINST_ASSOCSERVICE%, RTKSdWHwCodec_Service_Inst

; -------------- RTKSdWHwCodec driver install sections
[RTKSdWHwCodec_Service_Inst]
DisplayName    = %RTKSdWHwCodec.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\RTKSdWHwCodec.sys
LoadOrderGroup = Extended Base

;
;--- RTKSdWHwCodec_Device Coinstaller installation ------
;
;[DestinationDirs]
;RTKSdWHwCodec_Device_CoInstaller_CopyFiles = 13
;
;[RTKSdWHwCodec_Device.NT.CoInstallers]
;AddReg=RTKSdWHwCodec_Device_CoInstaller_AddReg
;CopyFiles=RTKSdWHwCodec_Device_CoInstaller_CopyFiles
;
;[RTKSdWHwCodec_Device_CoInstaller_AddReg]
;HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"
;
;[RTKSdWHwCodec_Device_CoInstaller_CopyFiles]
;WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll
;
;[SourceDisksFiles]
;WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

[RTKSdWHwCodec_Device.NTamd64.Wdf]
KmdfService =  RTKSdWHwCodec, RTKSdWHwCodec_wdfsect

[RTKSdWHwCodec_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="Realtek Semiconductor Corp."
ClassName="SoundWire Slaves"
DiskName = "Realtek Codec Device Installation Disk"
RTKSdWHwCodec.DeviceDesc = "Realtek SoundWire HW Audio Codec Device Driver"
RTKSdWHwCodec.SVCDESC = "Realtek HW Audio Codec"
